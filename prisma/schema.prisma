// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- ENUMS (As regras fixas) ---
enum GameStatus {
  SUGGESTED // Está no backlog
  IN_POOL // Entrou no sorteio (Randomizer)
  ACTIVE // Foi o escolhido (Winner)
  COMPLETED // Zerado
  DROPPED // Dropado
}

enum QuestType {
  MAIN_QUEST
  SIDE_QUEST
}

enum PoolStatus {
  OPEN
  CLOSED
}

enum ProposalStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED
}

enum UserRole {
  GUILD_MASTER
  MEMBER
}

// --- MODELS (As Tabelas do seu Diagrama) ---

model User {
  id            String    @id @default(uuid())
  username      String?   @unique
  email         String?   @unique
  emailVerified DateTime? @map("email_verified")
  password      String?
  image         String?
  name          String?
  created_at    DateTime  @default(now())

  role                 UserRole                   @default(MEMBER)
  notice_board_tokens  Int                        @default(2)
  last_token_reset     DateTime                   @default(now())
  ai_cooldown_until    DateTime?

  accounts Account[]
  sessions Session[]

  // Relações (O User tem vários...)
  nominations          Game[]                     @relation("Nominator") // Jogos que indicou
  reviews              Review[] // Reviews que fez
  poolEntries          PoolEntry[] // Entradas no sorteio
  gameProgress         GameProgress[] // Progresso nos jogos
  favoriteGames        Game[]                     @relation("UserFavorites") // Jogos favoritos
  favoriteGamesYear    Game[]                     @relation("UserFavoritesYear") // Jogos favoritos do Ano Atual
  contractProgresses   CampaignContractProgress[]
  proposedSpecialGames SpecialGameProposal[]      @relation("ProposedSpecialGames")
  specialGameVotes     SpecialGameVote[]
  trackedDeals         UserTrackedDeal[]
  dismissedDeals       UserDismissedDeal[]

  xp_points       Int     @default(0)
  level           Int     @default(1)
  equipped_title  String?
  equipped_frame  String?
  equipped_banner String?
  equipped_theme  String? @default("cyberpunk")

  @@map("users")
}

model Account {
  id                String  @id @default(uuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model Game {
  id          String  @id @default(uuid())
  igdb_id     String? @unique
  title       String
  platform    String? // PC, Switch, PS5...
  cover_url   String? // Capa do jogo
  artwork_url String? // Arte em landscape/ultrawide para banners

  // Regras de Negócio
  quest_type QuestType // Main ou Side? [Critico para as regras]

  // Tempos
  hltb_time Int? // "How Long to Beat" (Regra < 10h)

  // Quem indicou? (FK para User)
  nominated_by_id String?
  nominator       User?   @relation("Nominator", fields: [nominated_by_id], references: [id], onDelete: SetNull)

  // Datas
  created_at DateTime @default(now())

  // Relações
  reviews            Review[]
  poolEntries        PoolEntry[] // Participações em sorteios
  wonPools           Pool[]                @relation("WinnerGame") // Potes que esse jogo venceu
  progress           GameProgress[]
  favoritedBy        User[]                @relation("UserFavorites") // Usuários que favoritararam
  favoritedByYear    User[]                @relation("UserFavoritesYear") // Usuários que favoritararam pro Ano Atual
  contracts          CampaignContract[]
  is_special_release Boolean               @default(false)
  specialProposals   SpecialGameProposal[]

  @@index([title])
  @@index([created_at])
  @@map("games")
}

// Novo modelo: Rastreia o progresso de cada gamer em cada jogo (Regra 3)
model GameProgress {
  id      String @id @default(uuid())
  user_id String
  user    User   @relation(fields: [user_id], references: [id], onDelete: Cascade)

  game_id String
  game    Game   @relation(fields: [game_id], references: [id], onDelete: Cascade)

  status              GameStatus @default(SUGGESTED) // O status agora é individual
  progress_percentage Int        @default(0) // De 0 a 100

  start_date DateTime? // Quando este usuário começou
  end_date   DateTime? // Quando completou ou dropou

  is_platinum Boolean   @default(false)
  platinum_at DateTime?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  // Garantir que um usuário tenha apenas 1 progresso por jogo
  @@unique([user_id, game_id])
  @@index([user_id, status])
  @@index([game_id, status])
  @@map("game_progress")
}

// Equivalente ao seu "Reviews" (Perfeito!)
model Review {
  id           String   @id @default(uuid())
  rating       Int // 0 a 10 ou 0 a 5
  difficulty   Int? // 1 a 5
  review_text  String?  @db.Text
  hours_played Int? // Seu "hours = played" (Stats reais)
  screenshots  String[] @default([])

  // Conexões
  user_id String
  user    User   @relation(fields: [user_id], references: [id], onDelete: Cascade)
  game_id String
  game    Game   @relation(fields: [game_id], references: [id], onDelete: Cascade)

  created_at DateTime @default(now())
  updated_at DateTime @default(now()) @updatedAt

  @@unique([user_id, game_id])
  @@index([created_at])
  @@map("reviews")
}

// Equivalente ao seu "Randomizer" (Generalizado para Main e Side)
model Pool {
  id String @id @default(uuid())

  // Se for Side Quest, tem mês/ano. Se for Main, pode ser nulo.
  month Int?
  year  Int?
  type  QuestType

  status PoolStatus @default(OPEN)

  // O Vencedor (Sorteado)
  winner_game_id String?
  winner_game    Game?   @relation("WinnerGame", fields: [winner_game_id], references: [id], onDelete: SetNull)

  // Os jogos que estão concorrendo neste pote
  entries    PoolEntry[]
  is_special Boolean     @default(false)

  created_at DateTime @default(now())

  @@index([type, status, created_at])
  @@map("pools")
}

// Equivalente ao seu "RandomizerEntries" (Tabela Pivô)
model PoolEntry {
  id String @id @default(uuid())

  pool_id String
  pool    Pool   @relation(fields: [pool_id], references: [id], onDelete: Cascade)

  game_id String
  game    Game   @relation(fields: [game_id], references: [id], onDelete: Cascade)

  // Quem colocou esse jogo NESTE pote específico? 
  // (Importante: As regras dizem Input Voce vs Padrinho )
  user_id String
  user    User   @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([pool_id, game_id])
  @@map("pool_entries")
}

// --- Quadro de Avisos (Notice Board) ---

enum ContractStatus {
  LOCKED
  AVAILABLE
  COMPLETED
  FAILED
}

model CampaignContract {
  id                  String @id @default(uuid())
  game_id             String
  game                Game   @relation(fields: [game_id], references: [id], onDelete: Cascade)
  sequence_order      Int // Ordem sequencial iniciando em 1
  title               String
  objective           String @db.Text
  daily_atomic_quest  String @db.Text
  progress_percentage Int // Porcentagem acumulada de progresso do jogo ao concluir este contrato (ex: 12, 25, 100)

  user_progresses CampaignContractProgress[]

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@unique([game_id, sequence_order])
  @@map("campaign_contracts")
}

model CampaignContractProgress {
  id          String           @id @default(uuid())
  user_id     String
  user        User             @relation(fields: [user_id], references: [id], onDelete: Cascade)
  contract_id String
  contract    CampaignContract @relation(fields: [contract_id], references: [id], onDelete: Cascade)
  status      ContractStatus   @default(LOCKED)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@unique([user_id, contract_id])
  @@map("campaign_contract_progress")
}

// --- Votação de Pausa Ativa & Special Release ---

model SpecialGameProposal {
  id               String         @id @default(uuid())
  quest_type       QuestType
  status           ProposalStatus @default(PENDING)

  igdb_id          String?
  game_title       String
  game_cover_url   String?
  existing_game_id String?
  existing_game    Game?          @relation(fields: [existing_game_id], references: [id], onDelete: SetNull)

  proposer_id      String
  proposer         User           @relation("ProposedSpecialGames", fields: [proposer_id], references: [id], onDelete: Cascade)

  votes            SpecialGameVote[]

  created_at       DateTime       @default(now())
  updated_at       DateTime       @updatedAt

  @@index([quest_type, status])
  @@map("special_game_proposals")
}

model SpecialGameVote {
  id          String              @id @default(uuid())
  proposal_id String
  proposal    SpecialGameProposal @relation(fields: [proposal_id], references: [id], onDelete: Cascade)

  user_id     String
  user        User                @relation(fields: [user_id], references: [id], onDelete: Cascade)

  approved    Boolean // true = Aceito, false = Rejeitado
  created_at  DateTime            @default(now())

  @@unique([proposal_id, user_id])
  @@map("special_game_votes")
}

// --- DEALS TRACKER PERSISTENCE ---

model UserTrackedDeal {
  id           String   @id @default(uuid())
  user_id      String
  user         User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  deal_id      String   // ID do jogo ou steamAppId
  steam_app_id Int?
  title        String
  slug         String
  cover_image  String?
  created_at   DateTime @default(now())

  @@unique([user_id, deal_id])
  @@index([user_id])
  @@map("user_tracked_deals")
}

model UserDismissedDeal {
  id           String   @id @default(uuid())
  user_id      String
  user         User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  game_title   String   // Lowercased or normalized title
  steam_app_id Int?
  reason       String?  @default("already_played") // "already_played" | "not_interested"
  created_at   DateTime @default(now())

  @@unique([user_id, game_title])
  @@index([user_id])
  @@map("user_dismissed_deals")
}

