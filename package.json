{
    "name": "gamers-aposentados",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "next dev",
        "build": "prisma generate && next build",
        "start": "next start",
        "lint": "eslint .",
        "format": "prettier --write .",
        "sales:check": "tsx scripts/verify-steam-sales.ts",
        "test": "playwright test",
        "test:ui": "playwright test --ui",
        "db:reset": "prisma migrate reset --force",
        "db:migrate": "prisma migrate dev",
        "db:seed": "tsx prisma/seed.ts",
        "db:deploy": "prisma migrate deploy",
        "db:prod:push": "npx dotenv-cli -e .env.production -- npx prisma db push",
        "db:agent:up": "docker compose up -d postgres_agent",
        "db:agent:push": "npx dotenv-cli -e .env.agent -- npx prisma db push",
        "db:agent:seed": "npx dotenv-cli -e .env.agent -- npx tsx prisma/seed.ts",
        "db:agent:studio": "npx dotenv-cli -e .env.agent -- npx prisma studio --port 5556"
    },
    "dependencies": {
        "@auth/prisma-adapter": "^2.11.1",
        "@google/genai": "^1.46.0",
        "@google/generative-ai": "^0.24.1",
        "@prisma/client": "^6.0.0",
        "@radix-ui/react-avatar": "^1.1.11",
        "@radix-ui/react-dialog": "^1.1.15",
        "@radix-ui/react-dropdown-menu": "^2.1.16",
        "@radix-ui/react-label": "^2.1.8",
        "@radix-ui/react-separator": "^1.1.8",
        "@radix-ui/react-slot": "^1.2.4",
        "@radix-ui/react-tabs": "^1.1.13",
        "@vercel/blob": "^2.3.1",
        "@vercel/speed-insights": "^1.3.1",
        "bcryptjs": "^3.0.3",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "date-fns": "^4.1.0",
        "dotenv": "^17.3.1",
        "lucide-react": "^0.563.0",
        "next": "^16.1.6",
        "next-auth": "^5.0.0-beta.30",
        "pg": "^8.18.0",
        "react": "19.2.0",
        "react-dom": "19.2.0",
        "react-icons": "^5.7.0",
        "tailwind-merge": "^3.4.0",
        "tailwindcss-animate": "^1.0.7",
        "zod": "^4.3.6"
    },
    "devDependencies": {
        "@playwright/test": "^1.58.2",
        "@tailwindcss/postcss": "^4",
        "@types/bcryptjs": "^2.4.6",
        "@types/node": "^20",
        "@types/react": "^19.2.7",
        "@types/react-dom": "^19",
        "babel-plugin-react-compiler": "1.0.0",
        "baseline-browser-mapping": "^2.9.19",
        "eslint": "^9",
        "eslint-config-next": "16.0.7",
        "eslint-config-prettier": "^10.1.8",
        "playwright": "^1.58.2",
        "prettier": "^3.8.1",
        "prettier-plugin-tailwindcss": "^0.7.2",
        "prisma": "^6.19.2",
        "tailwindcss": "^4",
        "tsx": "^4.21.0",
        "typescript": "^5"
    }
}
