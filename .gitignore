# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/generated/prisma

# Playwright Test Output
/tests/playwright-report/
/tests/test-results/

# Historical data (CSVs with personal info)
/data/historical/

# Temporary / Scratch scripts and dumps
/scratch/
*.sql

# Antigravity Kit & Stitch
/.agent/
/.agents/
/stitch-assets/
skills-lock.json
.agentignore
